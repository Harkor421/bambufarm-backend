# BambuFarm Server — environment variables
#
# Copy this file to `.env` and fill in your values for local development.
# In production (Railway), set these in the project's variables tab.
# All env vars are read in src/config.js.

# ─── Required ────────────────────────────────────────────────

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/bambufarm

# Shared key for app → server authenticated endpoints
# Must match `pushApiKey` in BambuFarm app's app.json `extra` block
API_KEY=replace_me

# Admin endpoint password — gates all /api/admin/* routes
ADMIN_PASSWORD=replace_me

# Apple Push Notification (APNs) — required for Live Activities + push notifications
# You need ONE of APNS_KEY_PATH or APNS_KEY_CONTENTS (the latter is preferred for cloud)
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX

# For local dev — path to .p8 file
APNS_KEY_PATH=./data/AuthKey_XXXXXXXXXX.p8

# For Railway / cloud — paste the .p8 contents (preserve newlines as \n)
# APNS_KEY_CONTENTS=-----BEGIN PRIVATE KEY-----\nXXXXXX\n-----END PRIVATE KEY-----

# Use sandbox host for dev TestFlight builds, production host for App Store builds
# APNS_HOST=api.sandbox.push.apple.com  # dev
APNS_HOST=api.push.apple.com            # prod

# ─── Optional (have sane defaults) ───────────────────────────

# HTTP port
PORT=3000

# Background poll interval — token refresh + printer discovery (default 30s)
POLL_INTERVAL_MS=30000

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Environment marker — `production` enables stricter behavior
NODE_ENV=development

# ─── Optional integrations ───────────────────────────────────

# Cloudflare R2 (S3-compatible) — used for training-data captures
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# External Tecnoprints broadcast integration
# TECNOPRINTS_UID=
# TECNOPRINTS_URL=

# Public demo camera (shows on the marketing landing page)
# PUBLIC_CAMERA_UID=

# Print-vision experimental feature
# VISION_ENABLED=false
# VISION_INTERVAL_MS=60000
# VISION_TARGET_UID=

# ─── Reserved (not currently used) ───────────────────────────

# ANTHROPIC_API_KEY=
# BAMBU_TOKEN=
# BAMBU_UID=
# PRINTER_ID=
